            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LED Desk Lamp\",\n  \"sku\": \"PRD-009\",\n  \"categoryId\": \"CATEGORY_UUID_HERE\",\n  \"unitPrice\": 1299.00,\n  \"currentStock\": 100,\n  \"minStockAlert\": 15,\n  \"location\": \"Rack F1\"\n}"
