    {
      "name": "Challans",
      "item": [
        {
          "name": "Create Challan (DRAFT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_UUID_HERE\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_UUID_1\",\n      \"quantity\": 50\n    },\n    {\n      \"productId\": \"PRODUCT_UUID_2\",\n      \"quantity\": 50\n    }\n  ],\n  \"status\": \"DRAFT\"\n}"
            }
          }
        },
        {
          "name": "Create Challan (CONFIRMED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_UUID_HERE\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_UUID_1\",\n      \"quantity\": 10\n    }\n  ],\n  \"status\": \"CONFIRMED\"\n}"
            }
          }
        },
        {
          "name": "List Challans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["challans"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "DRAFT", "disabled": true },
                { "key": "customerId", "value": "", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Challan by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id"],
              "variable": [
                { "key": "id", "value": "CHALLAN_UUID_HERE" }
              ]
            }
          }
        },
        {
          "name": "Confirm Challan (DRAFT → CONFIRMED)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "status"],
              "variable": [
                { "key": "id", "value": "CHALLAN_UUID_HERE" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            }
          }
        },
        {
          "name": "Cancel Challan",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["challans", ":id", "status"],
              "variable": [
                { "key": "id", "value": "CHALLAN_UUID_HERE" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CANCELLED\"\n}"
            }
          }
        }
